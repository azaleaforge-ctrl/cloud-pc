{
  "name": "ruang-kerja",
  "productName": "Ruang Kerja",
  "version": "1.0.1",
  "description": "Workspace kolaborasi LAN: folder project bersama, antrian otomatis, deteksi IDE, kontrol dev server, file browser real-time.",
  "main": "dist/main/index.js",
  "author": "Ruang Kerja",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "node scripts/build.mjs main",
    "build:preload": "node scripts/build.mjs preload",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis",
    "test:agent-todo": "node scripts/test-agent-todo.mjs",
    "test:agent-terminal": "node scripts/test-agent-terminal.mjs",
    "test:agent-attachments": "node scripts/test-agent-attachments.mjs",
    "test:agent-research": "node scripts/test-agent-research.mjs",
    "test:agent-model-capabilities": "node scripts/test-agent-model-capabilities.mjs",
    "test:agent-sessions": "node scripts/test-agent-sessions.mjs",
    "test:agent-failure-guard": "node scripts/test-agent-failure-guard.mjs",
    "test:agent-runtime": "npm run test:agent-todo && npm run test:agent-terminal && npm run test:agent-failure-guard && npm run test:agent-attachments && npm run test:agent-research && npm run test:agent-model-capabilities && npm run test:agent-sessions"
  },
  "build": {
    "appId": "com.ruangkerja.app",
    "productName": "Ruang Kerja",
    "artifactName": "Ruang-Kerja-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty*/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "azaleaforge-ctrl",
      "repo": "cloud-pc"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.1",
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
