{
  "name": "ruang-kerja",
  "productName": "Ruang Kerja",
  "version": "0.2.0",
  "description": "Workspace kolaborasi LAN: folder project bersama, antrian giliran, deteksi IDE, dan kontrol dev server.",
  "main": "dist/main/index.js",
  "author": "Ruang Kerja",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "node scripts/build.mjs main",
    "build:preload": "node scripts/build.mjs preload",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ruangkerja.app",
    "productName": "Ruang Kerja",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "azaleaforge-ctrl",
      "repo": "cloud-pc"
    }
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
